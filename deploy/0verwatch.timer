[Unit]
Description=Run 0verwatch host health survey periodically
Documentation=https://github.com/w01f/0verwatch

[Timer]
# First run shortly after boot, then every INTERVAL (default 5 min).
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true
Unit=0verwatch.service

[Install]
WantedBy=timers.target