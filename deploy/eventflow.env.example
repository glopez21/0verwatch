# 0verwatch EventFlow telemetry configuration
# Installed to /etc/0verwatch/eventflow.env (read by 0verwatch.service).
# Uncomment and set to enable telemetry pushes to an EventFlow/Augur instance.

# Base URL of the EventFlow API (no trailing slash, no /api path)
# EVENTFLOW_URL=https://eventflow.example.com

# API key presented as the X-API-Key header
# EVENTFLOW_API_KEY=replace-me

# Tenant identifier presented as the X-Tenant-ID header
# AUGUR_TENANT_ID=default
